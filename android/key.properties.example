# Plantilla para android/key.properties
#
# 1. Copia este archivo como "key.properties" en la misma carpeta (android/).
# 2. Rellena los valores con los del keystore que generaste.
# 3. NO lo subas a git: key.properties, *.jks y *.keystore ya estan ignorados.
#
# Si key.properties no existe, el build de release cae a la clave de debug
# y Play Console rechazara el AAB.

storePassword=
keyPassword=
keyAlias=upload
# Ruta absoluta al .jks. En Windows usa barras normales:
# storeFile=C:/Users/tu_usuario/keystores/diariotiempo-upload.jks
storeFile=
